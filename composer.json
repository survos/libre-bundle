{
    "name": "survos/libre-translate-bundle",
    "description": "wraps calls to libretranslate server. WIP",
    "keywords": [
        "symfony-ux",
        "symfony"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4|^4.0",
        "tacman/libretranslate": "^2.0",
        "symfony/http-client": "^8.1",
        "symfony/string": "^8.1",
        "symfony/validator": "^8.1",
        "survos/babel-bundle": "^2.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "symfony/cache": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\LibreTranslateBundle\\": "src/",
            "Surovs\\LibreTranslateBundle\\Tests\\": "tests/"
        }
    }
}
